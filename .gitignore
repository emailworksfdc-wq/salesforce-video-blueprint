# Python bytecode (compileall -b writes these next to sources)
*.pyc
*.pyo
__pycache__/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/
.lanevenv/

# Scratch space for parallel worktree runs. Holds probe bundles, raw sf --json
# responses, and run output; same sensitivity as outputs/, never commit it.
# Specifically: raw UNREDACTED org captures — org ids, tenant names, instance
# URLs, live agent session UUIDs. Never commit it.
# It also holds persistent browser profiles: a lane that drove Playwright will have
# a cookie jar here with a LIVE authenticated org session, so this must stay
# ignored even for a `git add -A`.
.lane-tmp/
.playwright-mcp/

# Pipeline outputs — run artifacts, blueprints, screenshots, network traces.
# These can contain real org data (record ids, field values); never commit them.
outputs/
inputs/

# Capture files and derived artifacts outside declared directories (may contain recorded field values)
# Tracked JSONL fixtures under tests/ are allowed; stray captures are not.
# examples/ holds synthetic captures, plus real captures that have been REDACTED
# and are guarded by a secret-scan test (see examples/README.md). Never move a
# raw, unredacted capture there — outputs/ is gitignored for exactly that reason.
/*.jsonl
/**/*.jsonl
!tests/**/*.jsonl
!examples/*.jsonl

# HTML reports outside outputs/ (may embed real record IDs and field values).
# docs/ is hand-authored documentation, not generated output — allowed.
/*.html
/**/*.html
!docs/**/*.html

# Agent bundles and spec YAML outside outputs/ (derived artifacts that should be in outputs/)
/*.agent
/**/*.agent
/*.yaml
/**/*.yaml
# But allow committed config and workflow YAML:
!pyproject.toml
!.github/**/*.yml
!.github/**/*.yaml

# Secrets / local config
.env
.env.*
*.pem
*.key

# Editor / OS
.DS_Store
.idea/
.vscode/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.lane-tmp/
