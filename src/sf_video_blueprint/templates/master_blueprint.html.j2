<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Salesforce Master Blueprint</title>
  <style>
    :root {
      --bg: #ffffff;
      --fg: #1a1a1a;
      --muted: #6b7280;
      --line: #e5e7eb;
      --accent: #0176d3;
      --accent-soft: #eaf3fb;
      --warn: #b45309;
      --ok: #0f766e;
      --danger: #b91c1c;
      --code-bg: #f6f8fa;
      --card: #fafbfc;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .wrap { max-width: 1160px; margin: 0 auto; padding: 32px 28px 96px; }
    header { border-bottom: 1px solid var(--line); padding-bottom: 22px; margin-bottom: 28px; }
    header h1 { font-size: 28px; margin: 0 0 8px; letter-spacing: -0.01em; }
    header .sub { color: var(--muted); font-size: 14px; }
    .meta { color: var(--muted); font-size: 13px; }
    .badges { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .badge { display: inline-block; padding: 3px 10px; font-size: 11.5px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); border: 1px solid #cfe3f5; }
    h2 { font-size: 22px; margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
    h3 { font-size: 17px; margin: 20px 0 8px; }
    p  { margin: 8px 0 12px; }
    code { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 13px; background: var(--code-bg); padding: 1px 6px; border-radius: 4px; }
    .code { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 12.5px; background: var(--code-bg); padding: 1px 6px; border-radius: 4px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 12px 0; }
    .callout { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 8px; padding: 12px 16px; margin: 14px 0; }
    .toc { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 20px; }
    .toc ol { margin: 6px 0 6px 18px; padding: 0; }
    .toc li { margin: 3px 0; }
    .anchor { color: var(--accent); text-decoration: none; }
    .anchor:hover { text-decoration: underline; }
    .kv { display: grid; grid-template-columns: 220px 1fr; gap: 4px 14px; font-size: 13.5px; margin: 8px 0; }
    .kv .k { color: var(--muted); }
    table { width: 100%; border-collapse: collapse; margin: 12px 0 18px; font-size: 13.5px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { background: var(--card); font-weight: 600; }
    tr:hover td { background: #fafafa; }
    .status { position: fixed; top: 12px; right: 12px; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; font-size: 12px; box-shadow: 0 4px 12px rgba(0,0,0,.06); }
    .status .dot { display: inline-block; width: 8px; height: 8px; border-radius: 999px; background: #22c55e; margin-right: 6px; vertical-align: middle; animation: pulse 1.6s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
    .step-num { display:inline-block; width: 24px; height: 24px; line-height: 24px; text-align: center; background: var(--accent); color: #fff; border-radius: 999px; margin-right: 8px; font-size: 12px; }
  </style>
</head>
<body>
<div class="status"><span class="dot"></span>Ready · blueprint generated</div>
<div class="wrap">
  <header>
    <h1>Salesforce Video-to-HTML Master Blueprint</h1>
    <div class="sub">Run-level documentation that maps user UI actions to backend execution, data mutation, and AI-agent implementation design.</div>
    <div class="meta">Generated at {{ generated_at }}</div>
    <div class="badges">
      <span class="badge">Recording: <b>{{ extraction.recording_id }}</b></span>
      <span class="badge">Run: <b>{{ run.run_id }}</b></span>
      <span class="badge">Org: <b>{{ run.org_url }}</b></span>
      <span class="badge">Steps: <b>{{ analyses | length }}</b></span>
      <span class="badge">Evidence Artifacts: <b>{{ extraction.evidence | length }}</b></span>
    </div>
  </header>

  <nav class="toc">
    <b>Contents</b>
    <ol>
      <li><a class="anchor" href="#exec-summary">Executive Process Summary</a></li>
      <li><a class="anchor" href="#step-trace">Step-by-Step Action Trace</a></li>
      <li><a class="anchor" href="#data-ledger">Data Impact Ledger</a></li>
      <li><a class="anchor" href="#external-agent">Conversational Agentforce Service Agent</a></li>
      <li><a class="anchor" href="#evidence">Evidence Appendix</a></li>
    </ol>
  </nav>

  <h2 id="exec-summary">Executive Process Summary</h2>
  <div class="card">
    <div class="kv">
      <div class="k">Recording ID</div><div><code>{{ extraction.recording_id }}</code></div>
      <div class="k">Source Video</div><div><span class="code">{{ extraction.source_video_path }}</span></div>
      <div class="k">Org URL</div><div><span class="code">{{ run.org_url }}</span></div>
      <div class="k">User/Profile</div><div>{{ run.username }} / {{ run.profile_name }}</div>
      <div class="k">Run ID</div><div><code>{{ run.run_id }}</code></div>
    </div>
  </div>
  <div class="callout">
    This blueprint is designed as a production handoff artifact: every UI action should be traceable to backend execution and data changes, then mapped to conversational agent behavior.
  </div>

  <h2 id="step-trace">Step-by-Step Action Trace</h2>
  {% for analysis in analyses %}
    <div class="card">
      <h3><span class="step-num">{{ loop.index }}</span>{{ analysis.step_id }}</h3>
      <p><strong>Target:</strong> {{ analysis.action_target }}</p>
      <p><strong>Replay status:</strong> {{ analysis.replay_status.value if analysis.replay_status else "not_replayed" }}</p>
      <p><strong>Replay message:</strong> {{ analysis.replay_message or "n/a" }}</p>
      <p><strong>Triggered layers:</strong>
        {% if analysis.triggered_layers %}
          {{ analysis.triggered_layers | map(attribute='value') | join(", ") }}
        {% else %}
          none
        {% endif %}
      </p>
      <p><strong>Failure layer:</strong> {{ analysis.failure_layer.value if analysis.failure_layer else "none" }}</p>
      <p><strong>Failure reason:</strong> {{ analysis.failure_reason or "none" }}</p>
      <p><strong>Step screenshot:</strong>
        {% if analysis.screenshot_path %}
          <a class="anchor" href="file://{{ analysis.screenshot_path }}">{{ analysis.screenshot_path }}</a>
        {% else %}
          none
        {% endif %}
      </p>
      <p><strong>Step network trace:</strong>
        {% if analysis.network_trace_path %}
          <a class="anchor" href="file://{{ analysis.network_trace_path }}">{{ analysis.network_trace_path }}</a>
        {% else %}
          none
        {% endif %}
      </p>
    </div>
  {% endfor %}

  <h2 id="data-ledger">Data Impact Ledger</h2>
  {% for analysis in analyses %}
    {% if analysis.data_changes %}
      <div class="card">
        <h3>{{ analysis.step_id }}</h3>
        <table>
          <thead>
            <tr>
              <th>Object</th>
              <th>Record</th>
              <th>Changed fields</th>
            </tr>
          </thead>
          <tbody>
            {% for change in analysis.data_changes %}
              <tr>
                <td>{{ change.object_api_name }}</td>
                <td>{{ change.record_id }}</td>
                <td>{{ change.changed_fields | join(", ") }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  {% endfor %}

  <h2 id="external-agent">Conversational Agentforce Service Agent</h2>
  {% for section in agent_sections %}
    <div class="card">
      <h3>{{ section.intent }}</h3>
      <p><strong>Entities:</strong> {{ section.required_entities | join(", ") }}</p>
      <p><strong>Orchestration steps:</strong></p>
      <ul>
        {% for item in section.orchestration_steps %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <p><strong>Guardrails:</strong></p>
      <ul>
        {% for item in section.guardrails %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <p><strong>Failure handling:</strong></p>
      <ul>
        {% for item in section.failure_handling %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}

  <h2 id="evidence">Evidence Appendix</h2>
  <div class="card">
    <p>Total extracted actions: {{ extraction.actions | length }}</p>
    <p>Total evidence artifacts: {{ extraction.evidence | length }}</p>
  </div>
</div>
</body>
</html>
